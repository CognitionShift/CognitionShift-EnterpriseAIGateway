# CognitionShift Enterprise AI Gateway — Environment Configuration
#
# Copy this file to infra/.env and fill in your values:
#   cp .env.example infra/.env
#
# Then generate the backend config:
#   bash infra/generate-env.sh
#
# NEVER commit .env files with real values to version control.

# ============================================================
# REQUIRED
# ============================================================

# Domain name — Caddy auto-provisions TLS via Let's Encrypt.
# For local development, use "localhost".
DOMAIN=gateway.example.com

# At least one model provider API key is required.
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=

# JWT signing key — generate with: openssl rand -hex 32
# If left blank, one is auto-generated during setup.
SECRET_KEY=

# ============================================================
# OPTIONAL — secure defaults generated automatically
# ============================================================

# Database password (auto-generated if blank)
DB_PASSWORD=

# Redis password (auto-generated if blank)
REDIS_PASSWORD=

# Initial admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# ============================================================
# WHITE-LABEL BRANDING (optional)
# ============================================================

# Your organization's name — displayed prominently in the UI.
# When set, "Powered by CognitionShift" appears as subtle footer.
# When unset, CognitionShift branding is used throughout.
NEXT_PUBLIC_ORG_NAME=

# URL to your organization's logo (displayed on login, sidebar, chat)
NEXT_PUBLIC_ORG_LOGO_URL=

# Custom tagline (shown on login page and chat welcome)
NEXT_PUBLIC_ORG_TAGLINE=
