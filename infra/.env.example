# CognitionShift Enterprise AI Gateway — Production Environment
# Copy this to .env and fill in your values:
#   cp .env.example .env

# ============================================================
# REQUIRED
# ============================================================

# Domain name (Caddy auto-provisions TLS via Let's Encrypt)
DOMAIN=gateway.example.com

# JWT signing key (generate: openssl rand -hex 32)
SECRET_KEY=

# At least one model provider API key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ============================================================
# OPTIONAL (secure defaults auto-generated if blank)
# ============================================================

# Database password (auto-generated if blank)
DB_PASSWORD=

# Redis password (auto-generated if blank)
REDIS_PASSWORD=

# Google Drive file import (client-side Picker API — no server-side Drive access)
# Create OAuth client ID: https://console.cloud.google.com/apis/credentials
# Enable: Google Picker API
# Set authorized JavaScript origins to your DOMAIN
GOOGLE_OAUTH_CLIENT_ID=
# API key with Picker API restriction
GOOGLE_API_KEY=

# Initial admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Log level
LOG_LEVEL=info
